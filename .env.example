# =============================================================================
# OpenProject on Coolify -- Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# In Coolify, add these in the "Environment Variables" panel instead.
# =============================================================================

# ---- Required ----

# Rails secret key for session encryption and signed cookies.
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# PostgreSQL database password.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Shared secret for the Hocuspocus collaborative editing server.
# Generate with: openssl rand -hex 32
COLLABORATIVE_SERVER_SECRET=

# Your domain name WITHOUT protocol (no https://).
# Example: project.example.com
OPENPROJECT_HOST__NAME=

# ---- Optional: SMTP / Email ----
# Uncomment and configure to enable email notifications.

# OPENPROJECT_EMAIL__DELIVERY__METHOD=smtp
# OPENPROJECT_SMTP__ADDRESS=smtp.example.com
# OPENPROJECT_SMTP__PORT=587
# OPENPROJECT_SMTP__DOMAIN=example.com
# OPENPROJECT_SMTP__AUTHENTICATION=plain
# OPENPROJECT_SMTP__USER__NAME=your-email@example.com
# OPENPROJECT_SMTP__PASSWORD=your-smtp-password
# OPENPROJECT_SMTP__ENABLE__STARTTLS__AUTO=true
# OPENPROJECT_MAIL__FROM=openproject@example.com
